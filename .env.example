# PhysioAlign Environment Configuration

# Copy this file to .env and input your Google Gemini API Key.
# Get a free key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Clerk Publishable Key (Google Sign-In)
# Sign up at https://clerk.com/ and get your key from the Dashboard.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
