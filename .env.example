# PhysioAlign configuration. Copy to .env and fill in.

# Postgres connection string. On Render with Supabase, use the Session pooler URL.
DATABASE_URL=postgres://user:password@localhost:5432/physio

# Signs session cookies. Generate one with: openssl rand -hex 32
AUTH_SECRET=change_me

# Gemini API key (https://aistudio.google.com/). Server only. Without it you get placeholder reports.
GEMINI_API_KEY=

# Google sign-in client ID. Read by the frontend at build time and by the backend to verify tokens.
VITE_GOOGLE_CLIENT_ID=

# Comma separated emails that may sign up as admin. Empty = only the first account can.
# ADMIN_EMAILS=you@example.com

# Only if the frontend is served from a different origin than the API
# CORS_ORIGIN=https://your-frontend.example.com

# PORT=5001

# Used by `npm test` for the API tests. Point it at a throwaway database, it gets wiped.
# TEST_DATABASE_URL=postgres://localhost:5432/physio_test
