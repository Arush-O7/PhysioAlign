# PhysioAlign Environment Configuration

# Google Gemini API Key (Get a free key at: https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Google Sign-In Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Database connection string (Supabase PostgreSQL / Cloud Postgres)
DATABASE_URL=your_supabase_postgresql_connection_string_here
