# PhysioAlign environment configuration

# Postgres connection string (Supabase or any other Postgres)
DATABASE_URL=your_postgres_connection_string_here

# Secret used to sign login tokens. Generate one with: openssl rand -hex 32
AUTH_SECRET=change_me

# Gemini API key (free at https://aistudio.google.com/). Only the backend uses it.
GEMINI_API_KEY=your_google_gemini_api_key_here

# Google Sign-In client ID. The frontend needs the VITE_ one, the backend reads it too
# to check the token audience.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Comma separated emails allowed to sign up as admin. If left empty, only the very
# first account can pick admin; after that admins are promoted from the admin portal.
# ADMIN_EMAILS=you@example.com

# Only needed if the frontend is hosted on a different origin than the API
# CORS_ORIGIN=https://your-frontend.example.com

# Backend port (optional, defaults to 5001)
# PORT=5001
