{
  "name": "physioalign-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "tsx watch backend/src/index.ts",
    "dev:full": "concurrently -n web,api \"npm run dev\" \"npm run dev:backend\"",
    "build": "tsc && vite build && tsc -p backend/tsconfig.json",
    "start": "node backend/build/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:smoothing": "tsx scripts/bench-smoothing.ts",
    "db:check": "tsx scripts/check-db.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@mediapipe/tasks-vision": "0.10.32",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "lucide-react": "^0.454.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-webcam": "^7.2.0",
    "recharts": "^2.10.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^8.2.2",
    "jsdom": "^25.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
